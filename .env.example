# =============================================================================
# Environment: development | production
# In production the server refuses to start without API key + CORS allowlist.
# =============================================================================
APP_ENV=development

# --- AWS / S3 (prefer IAM role on EC2/ECS/EKS; omit static keys in production) ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
# Optional folder prefix inside the bucket (no leading/trailing slash)
# Result key example: vaschools-uploads/images/photo-....jpg
S3_BASE_PATH=
# Optional: MinIO / LocalStack
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Prefer bucket policy over ACL on modern AWS buckets
S3_USE_ACL=false
# Bật presigned CHỈ khi bucket private và nội dung không cần sống lâu:
# URL sinh ra hết hạn sau S3_PRESIGNED_URL_EXPIRY phút, nhưng nó được lưu
# vào DB lúc upload nên ảnh sẽ 403 sau đó. Với kho ảnh công khai, để false.
S3_USE_PRESIGNED_URL=false
S3_PRESIGNED_URL_EXPIRY=60

# --- HTTP server ---
PORT=8080
SERVER_READ_TIMEOUT_SECONDS=180
SERVER_WRITE_TIMEOUT_SECONDS=180
SERVER_IDLE_TIMEOUT_SECONDS=120
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30

# --- File logs (also printed to stdout) ---
# Daily files: storage/logs/app-YYYY-MM-DD.log
LOG_DIR=./storage/logs
LOG_PREFIX=app

# --- Upload limits ---
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ABSOLUTE_MAX_MB=200
UPLOAD_TIMEOUT_SECONDS=300

# --- API security (set APP_ENV=production + require key before public deploy) ---
API_ENABLED=true
API_REQUIRE_KEY=false
API_KEY=
# Comma-separated origins. Never use * in production.
CORS_ORIGINS=*

# --- CSRF (SPA same-origin: leave on; set SECURE_COOKIE=true behind HTTPS) ---
CSRF_ENABLED=true
CSRF_SECURE_COOKIE=false

# --- Rate limit & concurrency ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_CLEANUP_MINUTES=10
CONCURRENCY_LIMIT_ENABLED=true
MAX_CONCURRENT_UPLOADS=500
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=30
# Trần riêng cho tải ảnh gốc (/api/v1/public/artworks/{id}/download).
# Chặt hơn hẳn bộ đếm chung: đây là thao tác đắt nhất trên trang public và là
# đích ngắm chính của việc thu thập tranh hàng loạt.
RATE_LIMIT_DOWNLOAD_REQUESTS=30
RATE_LIMIT_DOWNLOAD_WINDOW_MINUTES=1

# --- Bảo mật ---
# Dải IP được phép đặt X-Forwarded-For/X-Real-IP. Chỉ những chặng kết nối nằm
# trong danh sách này mới được tin, phần còn lại dùng thẳng địa chỉ kết nối.
# Mặc định loopback vì Nginx chạy cùng máy (xem deploy/nginx/).
# ĐỂ RỖNG nếu app phơi thẳng ra Internet không qua proxy.
# Đặt sau Cloudflare/load balancer thì phải khai dải IP của dịch vụ đó, nếu
# không mọi khách sẽ bị gom vào chung một bộ đếm rate limit.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Chống tải trọn site bằng công cụ tự động (WinHTTrack, wget -r, Scrapy...).
# Bot tìm kiếm hợp lệ (Googlebot, bingbot, facebookexternalhit, coccocbot...)
# được miễn hoàn toàn để không ảnh hưởng SEO.
BOT_GUARD_ENABLED=true
# Số request tối đa trong 1 phút từ một IP trước khi bị coi là máy quét.
BOT_GUARD_MAX_REQUESTS_PER_MINUTE=240
# Số đường dẫn KHÁC NHAU tối đa trong 1 phút - dấu hiệu đặc trưng của trình
# tải site: người thật xem đi xem lại vài trang, máy quét đi qua mỗi URL một lần.
BOT_GUARD_MAX_PATHS_PER_MINUTE=150
BOT_GUARD_BLOCK_MINUTES=10

# HSTS: mặc định theo APP_ENV=production. CHỈ bật khi site đã chạy HTTPS hoàn
# toàn - bật khi còn phục vụ HTTP sẽ khoá trình duyệt khỏi site suốt max-age.
# Để trống = theo APP_ENV; đặt true/false để quyết định tường minh.
SECURITY_HSTS_ENABLED=

# Origin ngoài được phép trong Content-Security-Policy. Domain S3 đã tự suy ra
# từ S3_BUCKET_NAME/AWS_REGION/S3_ENDPOINT, chỉ khai thêm khi dùng CDN riêng.
SECURITY_CSP_IMAGE_SOURCES=
SECURITY_CSP_CONNECT_SOURCES=

# Trần kích thước body cho endpoint KHÔNG phải upload ảnh (đơn vị KB).
# Nginx đặt client_max_body_size 200m cho đường upload, nên nếu thiếu giới hạn
# này thì cả endpoint bình luận cũng nhận được body 200MB.
MAX_JSON_BODY_KB=1024

# --- Database (MySQL) ---
# DATABASE_URL format: user:pass@tcp(host:port)/dbname
# parseTime=true/charset=utf8mb4/multiStatements=true được tự động bổ sung nếu thiếu
# (xem internal/database.NormalizeMySQLDSN), không bắt buộc gõ tay ở đây.
DATABASE_ENABLED=false
DATABASE_DRIVER=mysql
DATABASE_URL=root:@tcp(localhost:3306)/va_stu_pic_db_prd
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5
DATABASE_MAX_LIFETIME=300
DATABASE_AUTO_MIGRATE=true

# --- Admin login: Google OAuth + session cookie ---
# Tạo Client ID/Secret tại https://console.cloud.google.com/apis/credentials
# (OAuth consent screen -> Web application -> Authorized redirect URI phải
# khớp chính xác GOOGLE_REDIRECT_URL, vd http://localhost:8080/auth/google/callback
# hoặc https://pictures.vaschools.edu.vn/auth/google/callback ở production).
# Server vẫn khởi động bình thường nếu để trống - chỉ /auth/google/* trả 503
# cho tới khi được điền đầy đủ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Dùng để ký/rotate phía server, không phải giá trị session (session lưu DB).
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Chỉ cho phép đăng nhập admin bằng email thuộc các domain này (phẩy phân
# tách nếu nhiều domain, để trống = không giới hạn).
# Khuyến nghị set ở production, vd: vaschools.edu.vn,hcm.vaschools.edu.vn
ADMIN_ALLOWED_EMAIL_DOMAIN=
# Whitelist email cụ thể được phép đăng nhập admin (phẩy phân tách). Có độ ưu
# tiên CAO HƠN ADMIN_ALLOWED_EMAIL_DOMAIN: khi danh sách này không rỗng thì chỉ
# đúng các email liệt kê mới vào được, email khác (kể cả cùng domain trường)
# đều bị từ chối và không được tự tạo tài khoản admin.
# Để trống = dùng danh sách mặc định trong internal/config/builder.go
# (defaultAllowedAdminEmails - 9 tài khoản ban quản trị).
ADMIN_ALLOWED_EMAILS=
