# =============================================================================
# Environment: development | production
# In production the server refuses to start without API key + CORS allowlist.
# =============================================================================
APP_ENV=development

# --- AWS / S3 (prefer IAM role on EC2/ECS/EKS; omit static keys in production) ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
# Optional: MinIO / LocalStack
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Prefer bucket policy over ACL on modern AWS buckets
S3_USE_ACL=false
S3_USE_PRESIGNED_URL=true
S3_PRESIGNED_URL_EXPIRY=60

# --- HTTP server ---
PORT=8080
SERVER_READ_TIMEOUT_SECONDS=180
SERVER_WRITE_TIMEOUT_SECONDS=180
SERVER_IDLE_TIMEOUT_SECONDS=120
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30

# --- File logs (also printed to stdout) ---
# Daily files: storage/logs/app-YYYY-MM-DD.log
LOG_DIR=./storage/logs
LOG_PREFIX=app

# --- Upload limits ---
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ABSOLUTE_MAX_MB=200
UPLOAD_TIMEOUT_SECONDS=300

# --- API security (set APP_ENV=production + require key before public deploy) ---
API_ENABLED=true
API_REQUIRE_KEY=false
API_KEY=
# Comma-separated origins. Never use * in production.
CORS_ORIGINS=*

# --- CSRF (SPA same-origin: leave on; set SECURE_COOKIE=true behind HTTPS) ---
CSRF_ENABLED=true
CSRF_SECURE_COOKIE=false

# --- Rate limit & concurrency ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_CLEANUP_MINUTES=10
CONCURRENCY_LIMIT_ENABLED=true
MAX_CONCURRENT_UPLOADS=500
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=30

# --- Optional database (required for /api/v1/upload-transaction) ---
DATABASE_ENABLED=false
DATABASE_DRIVER=postgres
DATABASE_URL=
DATABASE_MAX_OPEN=25
DATABASE_MAX_IDLE=5
DATABASE_MAX_LIFETIME=300

# --- WordPress-style local resize (/api/v1/wp-upload) ---
WORDPRESS_ENABLED=true
WORDPRESS_BASE_URL=http://localhost:8080
WORDPRESS_UPLOADS_DIR=./wp-uploads
# WORDPRESS_IMAGE_SIZES=thumbnail:150x150,medium:300x300,large:1024x1024
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_JPEG_QUALITY=85
IMAGE_PNG_QUALITY=90
IMAGE_ENABLE_WEBP=false
