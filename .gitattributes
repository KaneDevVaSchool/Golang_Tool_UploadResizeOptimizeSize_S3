# Script chạy trên VPS Linux BẮT BUỘC dùng LF. Nếu bị checkout thành CRLF
# trên Windows rồi push lên, bash trên server sẽ lỗi "\r: command not found".
*.sh            text eol=lf
deploy/**       text eol=lf
*.service       text eol=lf
*.conf          text eol=lf

# Ảnh và font là nhị phân — không được chuyển đổi dòng.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
