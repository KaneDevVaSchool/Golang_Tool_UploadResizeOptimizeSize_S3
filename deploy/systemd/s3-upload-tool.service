[Unit]
Description=S3 Upload Tool (pictures.vaschools.edu.vn)
Documentation=https://github.com/vaschools/s3-upload-tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/s3-upload-tool
EnvironmentFile=/opt/s3-upload-tool/.env
ExecStart=/opt/s3-upload-tool/server

# Tự khởi động lại khi crash. StartLimit chặn vòng lặp restart vô hạn khi
# app hỏng cấu hình (vd .env sai) — 5 lần lỗi trong 60s thì dừng hẳn để
# `systemctl status` báo failed thay vì restart mãi.
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Chờ tối đa 30s cho request đang chạy hoàn tất khi stop/restart —
# khớp SERVER_SHUTDOWN_TIMEOUT_SECONDS trong .env.
TimeoutStopSec=35
KillSignal=SIGTERM

LimitNOFILE=65535

# --- Sandbox: giới hạn thiệt hại nếu app bị khai thác --------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
# ProtectSystem=strict cho toàn hệ thống read-only; mở lại đúng các thư mục
# app cần ghi (upload tạm, log).
ReadWritePaths=/opt/s3-upload-tool/uploads /opt/s3-upload-tool/storage

# Log ra journald: xem bằng `journalctl -u s3-upload-tool -f`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
