# Cấu hình cho các script trong deploy/ (KHÔNG phải .env của ứng dụng).
#
# Chỉ cần khi muốn đổi khác mặc định. Cách dùng:
#   cp deploy/config.env.example deploy/config.env
#   nano deploy/config.env
#
# deploy.sh tự động nạp deploy/config.env nếu file tồn tại.

# Thư mục cài app trên VPS (chứa source + binary + .env + web/dist)
APP_DIR=/opt/s3-upload-tool

# User hệ thống chạy service (script tự tạo nếu chưa có)
APP_USER=appuser

# Domain phục vụ site. Phải khớp tên file trong deploy/nginx/
DOMAIN=pictures.vaschools.edu.vn

# Tên systemd service (không kèm .service)
SERVICE_NAME=s3-upload-tool

# Cổng app lắng nghe nội bộ, phải khớp PORT trong .env và proxy_pass trong nginx conf
APP_PORT=8080

# Nhánh git deploy.sh sẽ pull
GIT_BRANCH=main
